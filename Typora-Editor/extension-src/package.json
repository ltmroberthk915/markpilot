{
  "name": "markpilot",
  "displayName": "MarkPilot — AI Markdown Editor (Typora alternative)",
  "description": "AI-native Markdown editor in your IDE: inline AI completion (GLM / DeepSeek, bring your own key), Typora-style live math editing you can click into, large-file performance and print-quality CJK typography. 全面超越 Typora 的 AI Markdown 编辑器：行内 AI 补全、数学公式精准映射、大文件性能优化，可装进 VS Code / Trae 等 AI IDE。",
  "publisher": "jinxi",
  "author": {
    "name": "MarkPilot"
  },
  "version": "2.3.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ltmroberthk915/markpilot.git"
  },
  "homepage": "https://github.com/ltmroberthk915/markpilot#readme",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/markpilot/issues"
  },
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "keywords": [
    "markdown",
    "markdown editor",
    "typora",
    "typora alternative",
    "wysiwyg",
    "live preview",
    "ai completion",
    "ai writing",
    "autocomplete",
    "math",
    "latex",
    "katex",
    "mermaid",
    "outline",
    "notes",
    "note taking",
    "writing",
    "docx",
    "cjk",
    "chinese typography",
    "productivity",
    "MarkPilot"
  ],
  "categories": [
    "Notebooks",
    "Formatters",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markpilot.openInNewTab",
        "title": "用 MarkPilot 打开（新标签页）",
        "category": "MarkPilot"
      },
      {
        "command": "markpilot.addSelectionToChat",
        "title": "MarkPilot: 将选区加入 AI 对话"
      },
      {
        "command": "markpilot.completionSettings",
        "title": "MarkPilot: 补全设置"
      },
      {
        "command": "markpilot.completionAPIKey",
        "title": "MarkPilot: 填写 API Key"
      },
      {
        "command": "markpilot.completionModel",
        "title": "MarkPilot: 切换补全模型"
      },
      {
        "command": "markpilot.outline.reveal",
        "title": "MarkPilot: 跳转到大纲标题"
      }
    ],
    "customEditors": [
      {
        "viewType": "markpilot.editor",
        "displayName": "MarkPilot",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markpilot-outline",
          "title": "MarkPilot 大纲",
          "icon": "media/outline-icon.svg"
        }
      ]
    },
    "views": {
      "markpilot-outline": [
        {
          "type": "tree",
          "id": "markpilot.outline",
          "name": "Markdown 大纲"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "markpilot.openInNewTab",
          "when": "resourceExtname == .md",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "markpilot.openInNewTab",
          "when": "resourceExtname == .md"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editor.enablePreview": false,
      "workbench.editor.enablePreviewFromQuickOpen": false,
      "workbench.editor.enablePreviewFromCodeNavigation": false
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build": "npx vsce package",
    "publish": "npx vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6",
    "vsce": "^2.15.0"
  },
  "packageManager": "yarn@1.22.22"
}
