{
  "name": "dsh-markdown-editor-typora",
  "version": "2.0.9",
  "description": "MarkPilot CM6 3.6.20 Markdown editor for the DeepSeek Harness sidebar with version-guarded atomic saves and durable draft recovery.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "icon.png",
    "cordis.patch.yml",
    "core.json",
    "host.json",
    "host",
    "lib",
    "renderer-cm6",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "editor",
    "codemirror"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "check:core": "node scripts/sync-core.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltmroberthk915/markpilot.git",
    "directory": "dsh-markdown-editor-typora"
  },
  "homepage": "https://github.com/ltmroberthk915/markpilot/tree/main/dsh-markdown-editor-typora",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/markpilot/issues"
  }
}
